# 1. Cryptographic Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=replace_with_64_char_cryptographically_random_hex_secret_in_production
SESSION_SECRET=replace_with_64_char_cryptographically_random_hex_secret_in_production

# 2. Transactional Email Provider (Resend)
# Optional in development; when empty, OTP codes are logged to secure local developer console
RESEND_API_KEY=re_your_live_resend_api_key_here
EMAIL_FROM="Chinmaya Kumar Mishra <security@chinmayakumarmishra.sbs>"

# 3. Development & Testing Flags
# Set to "true" strictly during local automated test execution to allow test runners to verify OTP flows
DEBUG_OTP=false

# 4. Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://www.chinmayakumarmishra.sbs
